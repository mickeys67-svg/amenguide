// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String?
  provider       String   // "email" | "kakao" | "naver" | "google"
  passwordHash   String?  // email/password 가입 시 사용 (소셜 로그인은 null)
  targetDiocese  String?  // 관심 교구
  themeColor     String?  // 사용자 고유 스테인드글라스 테마 컬러
  bookmarks      Bookmark[]
  reviews        Review[]
  pushSubscriptions PushSubscription[]
  notices        Notice[]
  noticeComments NoticeComment[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityReactions CommunityReaction[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Event {
  id               String   @id @default(uuid())
  title            String
  date             DateTime?
  location         String?
  latitude         Float?
  longitude        Float?
  diocese          String?  // 소속 교구 (서울대교구, 부산교구 등 — location 기반 자동 추론)
  originUrl        String?  @unique  // 동일 URL 중복 저장 방지 + 중복체크 쿼리 인덱스
  aiSummary        String?  @db.Text
  themeColor       String?  // 스테인드글라스 테마 색상값
  category         String?  // 피정, 강론, 행사 등
  status           String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  imageUrl         String?  // 행사 대표 이미지
  submitterName    String?  // 등록자 이름
  submitterContact String?  // 등록자 연락처
  rejectionReason  String?  // 거절 사유
  bookmarks        Bookmark[]
  reviews          Review[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  user      User     @relation(fields: [userId], references: [id])
  event     Event    @relation(fields: [eventId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  rating    Int      // 1-5
  content   String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  type      String   // "D-7" | "D-1"
  sentAt    DateTime @default(now())

  @@unique([userId, eventId, type])
}

model Notice {
  id          String             @id @default(uuid())
  title       String
  content     String             @db.Text
  category    String             @default("일반")    // 일반, 공지, 긴급
  isPinned    Boolean            @default(false)
  status      String             @default("PENDING") // PENDING, APPROVED, REJECTED
  viewCount   Int                @default(0)
  authorId    String
  author      User               @relation(fields: [authorId], references: [id])
  comments    NoticeComment[]
  attachments NoticeAttachment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([authorId])
}

model NoticeComment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([noticeId])
}

model NoticeAttachment {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileSize  Int
  noticeId  String
  notice    Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model AiUsageLog {
  id        String   @id @default(uuid())
  ipHash    String   // SHA-256 해시 (개인정보 보호)
  usedDate  String   // YYYY-MM-DD (일별 카운팅용)
  createdAt DateTime @default(now())

  @@unique([ipHash, usedDate])
  @@index([usedDate])
}

// ── Cenaculum (친교의 다락방) 커뮤니티 ──────────────────────────────

model CommunityPost {
  id          String              @id @default(uuid())
  title       String
  content     String              @db.Text
  category    String              @default("자유게시판")  // 교리문답, 신앙나눔, 기도요청, 성경공부, 전례생활, 자유게시판
  status      String              @default("APPROVED")   // APPROVED, HIDDEN, DELETED
  isPinned    Boolean             @default(false)
  isClosed    Boolean             @default(false)         // 댓글 잠금
  isAnonymous Boolean             @default(false)         // 익명 게시 (기도요청 등)
  viewCount   Int                 @default(0)
  diocese     String?                                     // 교구별 필터링
  authorId    String
  author      User                @relation(fields: [authorId], references: [id])
  comments    CommunityComment[]
  reactions   CommunityReaction[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status, category, createdAt])
  @@index([authorId])
  @@index([diocese])
}

model CommunityComment {
  id        String              @id @default(uuid())
  content   String              @db.Text
  parentId  String?                                     // 2단계 답글
  parent    CommunityComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[]  @relation("CommentReplies")
  authorId  String
  author    User                @relation(fields: [authorId], references: [id])
  postId    String
  post      CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reactions CommunityReaction[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommunityReaction {
  id        String            @id @default(uuid())
  type      String            // pray, love, peace, wisdom, grace
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  postId    String?
  post      CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())

  @@unique([userId, postId, type])
  @@unique([userId, commentId, type])
  @@index([postId])
  @@index([commentId])
}
