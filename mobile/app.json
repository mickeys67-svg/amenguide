{
  "expo": {
    "name": "Catholica",
    "slug": "catholica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "catholica",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4080"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.catholica.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B4080"
      },
      "edgeToEdgeEnabled": true,
      "package": "kr.catholica.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B4080"
        }
      ]
    ]
  }
}
